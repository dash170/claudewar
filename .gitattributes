# Shell scripts must keep LF endings whatever the checkout platform.
# A CRLF .sh fails on Linux/macOS with "\r: command not found" — and init.sh is
# the first thing the README tells anyone to run.
*.sh text eol=lf

# Batch and PowerShell are the opposite case.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else: normalize in the repo, let git decide on checkout.
* text=auto
